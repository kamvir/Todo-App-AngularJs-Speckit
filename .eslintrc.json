{
  "env": {
    "browser": true,
    "jasmine": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "angular": "readonly",
    "inject": "readonly",
    "module": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }],
    "no-console": "off"
  }
}
